%masterFolder='/Users/grazianamodica/Biophotonics Dropbox/Graziana Modica/Graziana Data/SpIDAing/SpIDA_Data_Curated/SpIDA_St1_26012023/53BP1/53BP1GFP/01000';

%masterFolder='/Users/grazianamodica/Biophotonics Dropbox/Graziana Modica/Graziana Data/SpIDAing/SpIDA_Data_Curated/SpIDA_St1_26012023/mEGFPHA/rep4';

masterFolder='/Users/grazianamodica/Biophotonics Dropbox/Graziana Modica/Graziana Data/SpIDAing/SpIDA_Data_Curated/Graziana/SpIDA_St1_23Dec2022_BRCA1_IR/Foci analysis/3 hours/0GY';

%myFiles=dir(fullfile(masterFolder, '*ChanA*.tif'));
myFiles=dir(fullfile(masterFolder, '*_C2.tif')); % station 1

mkdir(fullfile(masterFolder, 'Background noise mask_GFP'));

%myFiles=dir(fullfile(masterFolder, '*_C3.tif')); % station 1
%mkdir(fullfile(masterFolder, 'Background noise mask_HA'));


uiwait(msgbox("Select a background region for each image. Get set, ready and... click click click!","Background Noise","modal"));


for itFile=1:size(myFiles,1)
 %for   itFile=9
    thisImageOriginal=imread(fullfile(masterFolder, myFiles(itFile).name));
    bkRegion=roipoly(imadjust(mat2gray(thisImageOriginal))); 
    bkIntensity=mean2(thisImageOriginal(bkRegion));

    save(fullfile(masterFolder, 'Background noise mask_GFP', [myFiles(itFile).name '.bkmask.mat']), 'bkRegion', 'bkIntensity');   
    %save(fullfile(masterFolder, 'Background noise mask_HA', [myFiles(itFile).name '.bkmask.mat']), 'bkRegion', 'bkIntensity');     
end

msgbox('You did it. all background noise mask done', 'Background Noise','modal')

close all


